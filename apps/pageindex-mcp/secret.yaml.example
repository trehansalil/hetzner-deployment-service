# Copy this file to secret.yaml, fill in base64-encoded values, then apply:
#   make k8s-secrets-pageindex
#
# To base64 encode a value:
#   echo -n 'your-value' | base64
#
# secret.yaml is gitignored. For production use Sealed Secrets or External Secrets Operator.
apiVersion: v1
kind: Secret
metadata:
  name: pageindex-mcp-secrets
  namespace: pageindex-mcp
type: Opaque
data:
  OPENAI_API_KEY: CHANGE_ME_BASE64
  AZURE_API_KEY: CHANGE_ME_BASE64           # When OPENAI_BASE_URL is an Azure endpoint, set this
                                            # to the SAME base64 value as OPENAI_API_KEY. litellm
                                            # (used by the worker) reads AZURE_API_KEY; the server's
                                            # AsyncAzureOpenAI uses OPENAI_API_KEY. Both must be set.
  MINIO_ACCESS_KEY: bWluaW9hZG1pbg==       # base64('minioadmin') — CHANGE THIS
  MINIO_SECRET_KEY: bWluaW9hZG1pbg==       # base64('minioadmin') — CHANGE THIS
  UPLOAD_API_KEY: CHANGE_ME_BASE64          # echo -n 'your-key' | base64 — SET THIS
  OPENAI_BASE_URL: ""                        # For Azure: echo -n 'https://<resource>.openai.azure.com' | base64
  MCP_BEARER_TOKEN: CHANGE_ME_BASE64         # echo -n 'your-token' | base64 — SET THIS
  # AZURE_API_VERSION and AZURE_API_BASE moved to pageindex-mcp-config (ConfigMap).
  # They are non-sensitive and live with the rest of the Azure routing config.
