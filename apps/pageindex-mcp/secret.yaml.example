# Copy this file to secret.yaml, fill in base64-encoded values, then apply:
#   make k8s-secrets-pageindex
#
# To base64 encode a value:
#   echo -n 'your-value' | base64
#
# secret.yaml is gitignored. For production use Sealed Secrets or External Secrets Operator.
apiVersion: v1
kind: Secret
metadata:
  name: pageindex-mcp-secrets
  namespace: pageindex-mcp
type: Opaque
data:
  OPENAI_API_KEY: CHANGE_ME_BASE64            # echo -n '<azure-api-key>' | base64
  # AZURE_API_KEY: set to the SAME base64 value as OPENAI_API_KEY. The worker's litellm
  # path reads AZURE_API_KEY; the server's AsyncAzureOpenAI uses OPENAI_API_KEY. Keeping
  # it explicit avoids relying on runtime mirroring (configure_litellm) — both are set.
  AZURE_API_KEY: CHANGE_ME_BASE64
  # OPENAI_BASE_URL is REQUIRED post-LLM-01: validate_llm_config() fails fast if empty.
  #   azure:      echo -n 'https://<resource>.openai.azure.com'  | base64   (active profile)
  #   compatible: echo -n 'https://<host>/v1'                    | base64   (then LLM_PROVIDER=compatible)
  # When LLM_PROVIDER=azure this MUST match AZURE_API_BASE in pageindex-mcp-config.
  OPENAI_BASE_URL: CHANGE_ME_BASE64
  MINIO_ACCESS_KEY: bWluaW9hZG1pbg==          # base64('minioadmin') — CHANGE THIS
  MINIO_SECRET_KEY: bWluaW9hZG1pbg==          # base64('minioadmin') — CHANGE THIS
  UPLOAD_API_KEY: CHANGE_ME_BASE64            # echo -n 'your-key'   | base64 — SET THIS
  MCP_BEARER_TOKEN: CHANGE_ME_BASE64          # echo -n 'your-token' | base64 — SET THIS

  # RFC-006 dual-write document registry. Points at the shared infra postgres.
  # The `pageindex` role + database are provisioned by `make init-pageindex-db`
  # (apps/infra/jobs/init-pageindex-db-job.yaml). The password here MUST match
  # infra-secrets.PAGEINDEX_DB_PASSWORD.
  #   echo -n 'postgresql://pageindex:<password>@postgres.infra.svc.cluster.local:5432/pageindex' | base64
  POSTGRES_DSN: CHANGE_ME_BASE64
  #
  # Non-sensitive routing (LLM_PROVIDER, AZURE_API_VERSION, AZURE_API_BASE,
  # PAGEINDEX_*MODEL) lives in the ConfigMap (pageindex-mcp-config), not here.
  # Per-stage models there mirror the engine: gpt-4.1 / gpt-5.4-mini / gpt-5.4-nano.
