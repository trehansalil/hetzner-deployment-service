# Copy this file to secret.yaml, fill in base64-encoded values, then apply:
#   make k8s-secrets-infra
#
# To base64 encode a value:
#   echo -n 'your-value' | base64
#
# secret.yaml is gitignored. For production use Sealed Secrets or External Secrets Operator.
#
# ─── CROSS-NAMESPACE CREDENTIAL MATCHING (load-bearing) ───────────────────────
# These are the SERVER-side credentials for the shared infra datastores. The
# CLIENT-side copies live in each app's own Secret and MUST hold identical values,
# because Secrets are namespace-scoped and cannot be referenced across namespaces:
#
#   infra-secrets.MINIO_ROOT_USER       == neonatal-care-secrets.MINIO_ACCESS_KEY
#                                       == pageindex-mcp-secrets.MINIO_ACCESS_KEY
#   infra-secrets.MINIO_ROOT_PASSWORD   == neonatal-care-secrets.MINIO_SECRET_KEY
#                                       == pageindex-mcp-secrets.MINIO_SECRET_KEY
#   infra-secrets.CLICKHOUSE_PASSWORD   == neonatal-care-secrets.DB_PASSWORD
#   infra-secrets.POSTGRES_USER/PASSWORD/DB are embedded in
#                                          app-secrets.DATABASE_URL (hr-chatbot)
# ──────────────────────────────────────────────────────────────────────────────
apiVersion: v1
kind: Secret
metadata:
  name: infra-secrets
  namespace: infra
type: Opaque
data:
  # ClickHouse (server). Must match neonatal-care-secrets.DB_PASSWORD.
  CLICKHOUSE_PASSWORD: Y2xpY2tob3VzZQ==   # base64('clickhouse') — CHANGE THIS

  # MinIO (server root). Must match the *_ACCESS_KEY / *_SECRET_KEY used by
  # neonatal-care and pageindex-mcp clients.
  MINIO_ROOT_USER: bWluaW9hZG1pbg==       # base64('minioadmin') — CHANGE THIS
  MINIO_ROOT_PASSWORD: bWluaW9hZG1pbg==   # base64('minioadmin') — CHANGE THIS

  # PostgreSQL (server). Must match the user/password/db embedded in
  # hr-chatbot app-secrets.DATABASE_URL.
  POSTGRES_USER: aHJjaGF0Ym90             # base64('hrchatbot') — CHANGE THIS
  POSTGRES_PASSWORD: CHANGE_ME_BASE64
  POSTGRES_DB: aHJjaGF0Ym90               # base64('hrchatbot') — CHANGE THIS
---
apiVersion: v1
kind: Secret
metadata:
  name: monitoring-secrets
  namespace: infra
type: Opaque
data:
  # Grafana admin credentials
  GF_SECURITY_ADMIN_USER: YWRtaW4=      # base64: admin
  GF_SECURITY_ADMIN_PASSWORD: YWRtaW4=  # base64: admin (change in production!)
