# secret.yaml.example — copy to secret.yaml, fill in base64-encoded values, then:
#   make k8s-secrets-hr
#
# To base64-encode a value:  echo -n 'myvalue' | base64
#
# secret.yaml is gitignored — never commit real secrets.
#
# PostgreSQL now runs in the `infra` namespace. POSTGRES_USER/PASSWORD/DB below are
# CLIENT-side copies and MUST match infra-secrets.POSTGRES_USER/PASSWORD/DB, and
# DATABASE_URL MUST point at host `postgres.infra.svc.cluster.local`.
# Grafana admin creds (monitoring-secrets) moved to apps/infra/secret.yaml.example.
---
apiVersion: v1
kind: Secret
metadata:
  name: app-secrets
  namespace: hr-chatbot
type: Opaque
data:
  # OpenAI API key (required)
  OPENAI_API_KEY: <base64-encoded-openai-api-key>

  # PostgreSQL credentials — must match infra-secrets in the infra namespace
  POSTGRES_USER: <base64-encoded-postgres-user>         # e.g. echo -n 'hrchatbot' | base64
  POSTGRES_PASSWORD: <base64-encoded-postgres-password>
  POSTGRES_DB: <base64-encoded-postgres-db>             # e.g. echo -n 'hrchatbot' | base64

  # Full connection URL — host MUST be postgres.infra.svc.cluster.local
  # e.g. echo -n 'postgresql://hrchatbot:password@postgres.infra.svc.cluster.local:5432/hrchatbot' | base64
  DATABASE_URL: <base64-encoded-database-url>

  # Chainlit auth secret (generate with: python -c "import secrets; print(secrets.token_hex(32))")
  CHAINLIT_AUTH_SECRET: <base64-encoded-chainlit-auth-secret>
